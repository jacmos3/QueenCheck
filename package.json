{
  "name": "queencheck-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "QueenCheck verifiable chess protocol and dynamic soulbound match records",
  "license": "MIT",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "compile": "hardhat --build-profile production build",
    "test": "hardhat --build-profile production test nodejs",
    "test:all": "npm test && npm --prefix app test",
    "build:app": "npm --prefix app run build",
    "build": "npm run compile && npm run build:app",
    "sync:abi": "node scripts/sync-abi.mjs",
    "check:abi": "node scripts/sync-abi.mjs --check",
    "check:size": "node scripts/check-contract-size.mjs",
    "check:deployment": "node scripts/check-deployment-manifest.mjs",
    "deploy:local": "hardhat --build-profile production ignition deploy ignition/modules/QueenCheck.ts --network hardhatOp",
    "deploy:base-sepolia": "node scripts/deploy-base-sepolia.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
    "@types/node": "^22.20.0",
    "hardhat": "3.15.0",
    "typescript": "~6.0.3",
    "viem": "2.56.3"
  }
}
